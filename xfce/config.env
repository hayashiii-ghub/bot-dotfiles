# xfce の既定値。このファイルは直さず、~/.config/bot-dotfiles/xfce.local.env に同じ名前で書いて上書きする
# 形は KEY=VALUE だけ。見た目 (dark / light) は look.env の BOT_LOOK で決まる
# 値は xfce4-terminal の標準 + ダーク配色。Thunar の開始フォルダは desktop の WORK_DIR の担当

TERM_FONT="Monospace 12"
TERM_FONT_USE_SYSTEM=false
TERM_SCROLLBACK=1000
TERM_SCROLLBAR=TERMINAL_SCROLLBAR_RIGHT

# TERM_BG などを直接書くと、見た目にかかわらずそれを使う
TERM_BG_DARK="#1e1e1e"
TERM_FG_DARK="#dcdcdc"
TERM_CURSOR_DARK="#dcdcdc"
TERM_PALETTE_DARK="#000000;#cc0000;#4e9a06;#c4a000;#3465a4;#75507b;#06989a;#d3d7cf;#555753;#ef2929;#8ae234;#fce94f;#729fcf;#ad7fa8;#34e2e2;#eeeeec"
TERM_DARK_THEME_DARK=true

TERM_BG_LIGHT="#ffffff"
TERM_FG_LIGHT="#1e1e1e"
TERM_CURSOR_LIGHT="#1e1e1e"
TERM_PALETTE_LIGHT="#000000;#c91b00;#00a600;#a68a00;#0037da;#b200b2;#00a6b2;#808080;#555555;#e74856;#16a34a;#b58900;#3b78ff;#c239b3;#0891b2;#1e1e1e"
TERM_DARK_THEME_LIGHT=false

THUNAR_VIEW=ThunarIconView                       # ThunarIconView / ThunarDetailsView / ThunarCompactView
THUNAR_ZOOM=THUNAR_ZOOM_LEVEL_100_PERCENT
THUNAR_SHOW_HIDDEN=false
THUNAR_SIDE_PANE_WIDTH=170
