# xfconf に書く値: channel<TAB>property<TAB>type<TAB>value (@ で囲んだ名前は設定の値になる)
xfce4-terminal	/font-name	string	@TERM_FONT@
xfce4-terminal	/font-use-system	bool	@TERM_FONT_USE_SYSTEM@
xfce4-terminal	/scrolling-lines	uint	@TERM_SCROLLBACK@
xfce4-terminal	/scrolling-bar	string	@TERM_SCROLLBAR@
xfce4-terminal	/color-use-theme	bool	false
xfce4-terminal	/color-background	string	@TERM_BG@
xfce4-terminal	/color-foreground	string	@TERM_FG@
xfce4-terminal	/color-cursor	string	@TERM_CURSOR@
xfce4-terminal	/color-palette	string	@TERM_PALETTE@
xfce4-terminal	/misc-use-dark-theme	bool	@TERM_DARK_THEME@
thunar	/last-view	string	@THUNAR_VIEW@
thunar	/last-icon-view-zoom-level	string	@THUNAR_ZOOM@
thunar	/last-show-hidden	bool	@THUNAR_SHOW_HIDDEN@
thunar	/last-separator-position	int	@THUNAR_SIDE_PANE_WIDTH@
