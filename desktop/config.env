# desktop の既定値。このファイルは直さず、~/.config/bot-dotfiles/desktop.local.env に同じ名前で書いて上書きする
# 形は KEY=VALUE だけ ($HOME と ~ は使える)。見た目 (dark / light) は look.env の BOT_LOOK で決まる

# 空なら DISPLAY → 自分の xfwm4 が1つならその DISPLAY (どれもダメならエラー)
BOT_DISPLAY=

# 壁紙とテーマ。WALLPAPER / THEME_NAME を書くと、見た目にかかわらずそれを使う
WALLPAPER=
WALLPAPER_DARK=$HOME/Pictures/bots-dark-wallpaper.png
WALLPAPER_LIGHT=$HOME/Pictures/bots-light-wallpaper.png
THEME_NAME=
THEME_DARK=Adwaita-dark
THEME_LIGHT=Adwaita

# desktop-setup の並べ方
SPLIT_X=50          # 左 (ブラウザ) の幅 %
SPLIT_Y=50          # 右上 (ターミナル) の高さ %
DOCK_RESERVE=70     # 下のドック (plank) 用に空ける px
WORK_DIR=$HOME      # ターミナル / Thunar の開始フォルダ
TERM_ROLE=main-terminal
TERM_TITLE=         # ROLE で見つからないとき、タイトルで探す (正規表現、空なら探さない)
TERM_CMD="exec bash"

# ブラウザ: "起動コマンド|WM_CLASS|タイトル" を空白で区切って並べる。前から順に探す
# BROWSER_CMD を書くといちばん先、BROWSER_EXTRA はその次 (マシン固有のものは local.env で足す)
BROWSER_CMD=
BROWSER_CLASS=
BROWSER_TITLE=
BROWSER_EXTRA=
BROWSER_CANDIDATES="google-chrome|google-chrome|Chrome chromium|chromium|Chromium chromium-browser|chromium|Chromium firefox|firefox|Firefox"

# wallpaper-keeper
KEEPER_INTERVAL=20      # 確かめる間隔 (秒)
KEEPER_X_TIMEOUT=120    # 起動したとき X を待つ秒数
KEEPER_DISPLAYS=        # wallpaper-keeper-all の対象 (例 ":N :N-M")。空なら自分の xfwm4 が動いている画面
